exports[`canonical POS receipt renderers > renders a stable receipt markup snapshot from canonical data 1`] = `"<article class="receipt" data-version="1"><div class="copy">COPY #2</div><header><h1>Kubika Shop</h1><p>Kigali</p><p>KN 3 Rd</p><p>+250700000000</p><p>TIN: 123456789</p></header><section class="meta"><span>Receipt: POS-1001</span><span>02/11/2026, 10:30:00 (Africa/Kigali)</span><span>Cashier: Aline</span><span>Register: Till 1</span></section><section class="meta"><strong>Customer</strong><span>Customer B</span><span>TIN: 987654321</span></section><table><thead><tr><th>Item</th><th>Amount</th></tr></thead><tbody><tr class="line"><td><strong>Tea</strong><small>TEA-1</small><small>Tax class: B</small><small>2 box × RWF 1,000</small></td><td>RWF 1,900</td></tr><tr class="detail"><td>Discount</td><td>-RWF 100</td></tr></tbody></table><table class="totals"><tbody><tr><td>Subtotal</td><td>RWF 2,000</td></tr><tr><td>Discount</td><td>-RWF 100</td></tr><tr><td>VAT 18% · taxable RWF 1,900</td><td>RWF 290</td></tr><tr><td>Tax total</td><td>RWF 290</td></tr><tr class="grand"><td>Total</td><td>RWF 2,190</td></tr></tbody></table><section><strong>Payments</strong><table><tbody><tr><td>CASH</td><td>RWF 2,190</td></tr></tbody></table></section><p class="paid">Paid: RWF 2,190</p><section class="fiscal"><strong>Fiscal receipt</strong><span>Receipt: 1001</span><span>production</span><img class="qr" src="data:image/png;base64,AAAA" alt="Fiscal QR code" /></section><footer><p>Murakoze cyane</p><p>Returns in 7 days</p></footer></article>"`;
